NODE_ENV=production
PORT=3000
BASE_URL=https://medical.ffsa.example
DATABASE_URL=postgres://ffsa:motdepasse@db:5432/ffsa
# openssl rand -base64 48
SESSION_SECRET=
# Clé de chiffrement des données de santé : openssl rand -base64 32
# À CONSERVER PRÉCIEUSEMENT et À PART des sauvegardes : sans elle, les données sont illisibles.
# Production : préférer un fichier fourni par le coffre de secrets de l'hébergeur HDS.
DATA_ENCRYPTION_KEY=
# DATA_ENCRYPTION_KEY_FILE=/run/secrets/ffsa_data_key
# Rotation : DATA_ENCRYPTION_KEYS=1:<ancienne>,2:<nouvelle> puis « npm run rotate-key »
# DATA_ENCRYPTION_KEYS=
TRUST_PROXY=1
SESSION_IDLE_MINUTES=30
DOCTOR_LINK_VALIDITY_DAYS=14
# Durée de conservation des dossiers (années), puis suppression automatique et définitive
RETENTION_YEARS=10
DOCTOR_REMINDER_HOURS=48
MAX_UPLOAD_MB=10
# Antivirus ClamAV (service « clamav » du docker-compose) : fichiers refusés si l'antivirus est injoignable
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
# Adresses notifiées à chaque dépôt (séparées par des virgules)
MEDICAL_SERVICE_EMAILS=service.medical@ffsa.org
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=FFSA - Service médical <no-reply@ffsa.org>
# Page « Données personnelles » (mentions RGPD) : à compléter puis valider par le DPO
PRIVACY_CONTROLLER=Fédération Française du Sport Automobile, <adresse du siège>
PRIVACY_DPO_CONTACT=dpo@ffsa.org
# Base légale validée par le DPO (texte affiché tel quel)
PRIVACY_LEGAL_BASIS=
# true une fois le texte validé (masque l'avertissement « texte provisoire »)
PRIVACY_VALIDATED=false
# SMS (lien et code envoyés au portable du médecin). Fournisseur pris en charge : brevo
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=FFSA
# Connexion avec le compte licencié FFSA (OpenID Connect, ex. Keycloak / Azure AD)
# URL de retour à déclarer chez le fournisseur : <BASE_URL>/connexion/sso/retour
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_LABEL=Se connecter avec mon compte licencié FFSA
OIDC_LICENSE_CLAIM=licence
OIDC_ORGANIZATION_CLAIM=asa
# Facultatif : n'autoriser que certains profils (ex. OIDC_REQUIRED_CLAIM=roles, OIDC_REQUIRED_VALUES=officiel,organisateur)
OIDC_REQUIRED_CLAIM=
OIDC_REQUIRED_VALUES=
# Adresses prévenues quand un organisateur sans compte licencié demande un accès
APPROVER_EMAILS=
