<%- include('../partials/header') %>
<div class="auth card">
  <h1>Double authentification</h1>
  <% if (method === 'email') { %>
    <p class="muted">Pour protéger les données, un code de connexion à 6 chiffres vient d'être envoyé à <strong><%= maskedEmail %></strong>. Il est valable 10 minutes.</p>
  <% } else { %>
    <p class="muted">Saisissez le code à 6 chiffres affiché dans votre application d'authentification.</p>
  <% } %>
  <% if (demoCode) { %><div class="alert info">Démonstration : le code est <strong class="mono"><%= demoCode %></strong> (<%= method === 'email' ? 'normalement lu dans vos e-mails' : 'normalement lu sur votre téléphone' %>).</div><% } %>
  <% if (resent) { %><div class="alert success">Un nouveau code vient d'être envoyé.</div><% } %>
  <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/connexion/2fa">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label class="label" for="code">Code</label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus class="code-input"></div>
    <button class="btn primary full" type="submit">Valider</button>
  </form>
  <% if (method === 'email') { %>
    <form method="post" action="/connexion/2fa/renvoyer" class="secondary-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn ghost full" type="submit">Recevoir un nouveau code</button>
    </form>
    <p class="help center">Astuce : dans « Sécurité », vous pouvez utiliser une application d'authentification à la place des codes par e-mail.</p>
  <% } %>
</div>
<%- include('../partials/footer') %>
