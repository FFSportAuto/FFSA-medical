<%- include('../partials/header') %>
<div class="auth card">
  <h1>Double authentification</h1>
  <p class="muted">Saisissez le code à 6 chiffres affiché dans votre application d'authentification.</p>
  <% if (demoCode) { %><div class="alert info">Démonstration : le code actuel est <strong class="mono"><%= demoCode %></strong> (normalement lu sur votre téléphone).</div><% } %>
  <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/connexion/2fa">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label class="label" for="code">Code</label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus class="code-input"></div>
    <button class="btn primary full" type="submit">Valider</button>
  </form>
</div>
<%- include('../partials/footer') %>
