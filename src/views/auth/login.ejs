<%- include('../partials/header') %>
<div class="auth card">
  <h1>Connexion</h1>
  <p class="muted">Espace réservé aux organisateurs et au service médical de la FFSA.</p>
  <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
  <% if (ssoLabel) { %>
    <a class="btn sso full" href="/connexion/sso"><img src="/static/img/favicon.png" alt="" width="20" height="20"><%= ssoLabel %></a>
    <div class="or"><span>ou avec votre e-mail</span></div>
  <% } %>
  <form method="post" action="/connexion">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field"><label class="label" for="email">E-mail</label><input id="email" name="email" type="email" value="<%= email %>" autocomplete="username" required autofocus></div>
    <div class="field"><label class="label" for="password">Mot de passe</label><input id="password" name="password" type="password" autocomplete="current-password" required></div>
    <button class="btn primary full" type="submit">Se connecter</button>
  </form>
  <p class="center"><a href="/mot-de-passe-oublie">Mot de passe oublié ?</a></p>
  <div class="signup-cta">
    <span>Organisateur sans compte ?</span>
    <a class="btn small" href="/inscription">Créer un compte</a>
  </div>
  <p class="muted small center">Médecins : utilisez le lien sécurisé reçu par e-mail, aucun compte n'est nécessaire.</p>
  <% if (demoAccounts.length) { %>
    <div class="demo-accounts">
      <span class="eyebrow">Comptes de démonstration</span>
      <% demoAccounts.forEach(function (a) { %>
        <div class="demo-account">
          <span><b><%= a.label %></b><span class="mono"><%= a.email %></span></span>
          <button type="button" class="btn small ghost" data-fill-login="<%= a.email %>" data-fill-password="<%= a.password %>">Utiliser</button>
        </div>
      <% }) %>
      <p class="help">Mot de passe commun : <span class="mono"><%= demoAccounts[0].password %></span>. Le code de double authentification est affiché à l'étape suivante.</p>
    </div>
  <% } %>
</div>
<%- include('../partials/footer') %>
