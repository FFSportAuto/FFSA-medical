<%- include('../partials/header') %>
<div class="auth card">
  <h1>Mot de passe oublié</h1>
  <% if (sent) { %>
    <div class="alert success">Si un compte correspond à cette adresse, un e-mail de réinitialisation vient d'être envoyé.</div>
    <p class="center"><a href="/connexion">Retour à la connexion</a></p>
  <% } else { %>
    <form method="post" action="/mot-de-passe-oublie">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label class="label" for="email">E-mail</label><input id="email" name="email" type="email" required autofocus></div>
      <button class="btn primary full" type="submit">Recevoir un lien</button>
    </form>
  <% } %>
</div>
<%- include('../partials/footer') %>
