<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> – FFSA</title>
  <link rel="icon" type="image/png" href="/static/img/favicon.png">
  <link rel="preload" href="/static/fonts/poppins-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
<% if (demoMode) { %><div class="demo-banner">Version de démonstration : données fictives uniquement. <a href="/demo/emails">Voir les e-mails envoyés</a></div><% } %>
<header class="topbar">
  <div class="wrap topbar-inner">
    <a class="brand" href="/"><img src="/static/img/logo-ffsa.png" alt="FFSA" width="178" height="30"><span class="brand-text">Rapports d'accident<br>&amp; rapports médicaux</span></a>
    <% if (user) { %>
    <nav class="nav">
      <% if (user.role === 'organizer') { %>
        <a href="/organisateur" class="<%= path === '/organisateur' ? 'active' : '' %>">Mes déclarations</a>
        <a href="/organisateur/rapports/nouveau" class="<%= path.endsWith('/nouveau') ? 'active' : '' %>">Déclarer un accident</a>
      <% } else { %>
        <a href="/back-office" class="<%= path === '/back-office' || path.startsWith('/back-office/dossiers') ? 'active' : '' %>">Dossiers</a>
        <% if (user.role === 'admin') { %>
          <a href="/back-office/utilisateurs" class="<%= path.startsWith('/back-office/utilisateurs') ? 'active' : '' %>">Utilisateurs</a>
          <a href="/back-office/audit" class="<%= path.startsWith('/back-office/audit') ? 'active' : '' %>">Audit</a>
        <% } %>
      <% } %>
      <a href="/compte/2fa" class="<%= path.startsWith('/compte') ? 'active' : '' %>">Sécurité</a>
      <form method="post" action="/deconnexion" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="linklike">Déconnexion</button>
      </form>
    </nav>
    <% } %>
  </div>
</header>
<main class="wrap">
