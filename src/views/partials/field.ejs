<%
  const v = values[field.name];
  const err = errors[field.name];
  const id = 'f_' + field.name;
  const showIf = field.showIf ? JSON.stringify(field.showIf) : '';
  // Listes courtes affichées en pastilles (choix unique), plus rapides au doigt qu'une liste déroulante
  const asPills = field.type === 'select' && field.options.length <= 5;
  const isName = /(^|_)(first_name|last_name|name)$/.test(field.name);
%>
<% if (field.type === 'heading') { %>
<h4 class="subheading"><%= field.label %></h4>
<% } else { %>
<div class="field <%= field.width || '' %> <%= err ? 'has-error' : '' %>" data-field="<%= field.name %>" data-type="<%= asPills ? 'radio' : field.type %>"<% if (field.shortLabel) { %> data-label="<%= field.shortLabel %>"<% } %><% if (field.required) { %> data-required<% } %><% if (field.columnsFollow) { %> data-columns-follow="<%= field.columnsFollow %>"<% } %><% if (field.pattern) { %> data-pattern="<%= field.pattern %>" data-pattern-message="<%= field.patternMessage || 'Format invalide.' %>"<% } %> <% if (showIf) { %>data-show-if="<%= showIf %>"<% } %>>
  <% if (field.type === 'matrix') { %>
    <span class="label"><%= field.label %><% if (field.required) { %> <abbr title="obligatoire">*</abbr><% } %></span>
    <div class="matrix-wrap">
      <table class="matrix">
        <thead><tr><th></th><% field.columns.forEach(function (c, ci) { %><th data-col="<%= ci %>"><%= c %></th><% }) %></tr></thead>
        <tbody>
        <% field.rows.forEach(function (row, ri) { %>
          <tr><th scope="row"><%= row %></th>
          <% field.columns.forEach(function (col, ci) {
               const name = field.name + '__' + ri + '__' + ci;
               const cv = (v && v[row] && v[row][col] !== undefined) ? v[row][col] : ''; %>
            <td data-col="<%= ci %>" data-col-label="<%= col %>">
              <% if (field.cell.type === 'select') { %>
                <select name="<%= name %>" aria-label="<%= row %> – <%= col %>">
                  <option value=""></option>
                  <% field.cell.options.forEach(function (o) { %><option <%= cv === o ? 'selected' : '' %>><%= o %></option><% }) %>
                </select>
              <% } else { %>
                <input type="<%= field.cell.type === 'number' ? 'number' : 'text' %>" name="<%= name %>" value="<%= cv %>" aria-label="<%= row %> – <%= col %>" <% if (field.cell.type === 'number') { %>min="<%= field.cell.min %>" max="<%= field.cell.max %>" inputmode="numeric"<% } %> enterkeyhint="next">
              <% } %>
            </td>
          <% }) %>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  <% } else if (field.type === 'consent') { %>
    <label class="check consent"><input type="checkbox" name="<%= field.name %>" value="1" <%= v ? 'checked' : '' %>> <span><%= field.label %><% if (field.required) { %> <abbr title="obligatoire">*</abbr><% } %></span></label>
  <% } else { %>
    <% if (['radio', 'checkboxes'].includes(field.type) || asPills) { %>
      <span class="label" id="<%= id %>_label"><%= field.label %><% if (field.required) { %> <abbr title="obligatoire">*</abbr><% } %></span>
    <% } else { %>
      <label class="label" for="<%= id %>"><%= field.label %><% if (field.required) { %> <abbr title="obligatoire">*</abbr><% } %></label>
    <% } %>

    <% if (['text', 'email', 'tel', 'date', 'time', 'number'].includes(field.type)) { %>
      <input id="<%= id %>" name="<%= field.name %>" type="<%= field.type %>" value="<%= v ?? '' %>"
        <% if (field.placeholder) { %>placeholder="<%= field.placeholder %>"<% } %>
        <% if (field.min !== undefined) { %>min="<%= field.min %>"<% } %>
        <% if (field.max !== undefined) { %>max="<%= field.max %>"<% } %>
        <% if (field.type === 'number') { %>step="any" inputmode="<%= field.inputmode || 'numeric' %>"<% } else if (field.inputmode) { %>inputmode="<%= field.inputmode %>"<% } %>
        <% if (['email', 'tel'].includes(field.type) || field.inputmode) { %>autocapitalize="off" spellcheck="false"<% } else if (isName) { %>autocapitalize="words" spellcheck="false"<% } %>
        <% if (field.sameAs) { %>data-same-as="<%= field.sameAs.field %>" data-same-as-label="<%= field.sameAs.label %>"<% } %>
        <% if (field.autoNow) { %>data-auto-now<% } %>
        autocomplete="off" enterkeyhint="next"
        data-required="<%= field.required ? 1 : 0 %>">
    <% } else if (field.type === 'textarea') { %>
      <textarea id="<%= id %>" name="<%= field.name %>" rows="<%= field.rows || 4 %>" data-required="<%= field.required ? 1 : 0 %>"><%= v ?? '' %></textarea>
    <% } else if (asPills) { %>
      <div class="choices" role="radiogroup" aria-labelledby="<%= id %>_label">
        <% field.options.forEach(function (o) { %>
          <label class="check"><input type="radio" name="<%= field.name %>" value="<%= o %>" <%= v === o ? 'checked' : '' %>> <span><%= o %></span></label>
        <% }) %>
      </div>
    <% } else if (field.type === 'select') { %>
      <select id="<%= id %>" name="<%= field.name %>" data-required="<%= field.required ? 1 : 0 %>">
        <option value="">— Choisir —</option>
        <% field.options.forEach(function (o) { %><option <%= v === o ? 'selected' : '' %>><%= o %></option><% }) %>
      </select>
    <% } else if (field.type === 'radio') { %>
      <div class="choices" role="radiogroup" aria-labelledby="<%= id %>_label">
        <% field.options.forEach(function (o) { %>
          <label class="check"><input type="radio" name="<%= field.name %>" value="<%= o %>" <%= v === o ? 'checked' : '' %>> <span><%= o %></span></label>
        <% }) %>
      </div>
    <% } else if (field.type === 'checkboxes') { %>
      <div class="choices" role="group" aria-labelledby="<%= id %>_label">
        <% const arr = [].concat(v || []); field.options.forEach(function (o) { %>
          <label class="check"><input type="checkbox" name="<%= field.name %>" value="<%= o %>" <%= arr.includes(o) ? 'checked' : '' %>> <span><%= o %></span></label>
        <% }) %>
      </div>
    <% } else if (field.type === 'file') { %>
      <input id="<%= id %>" name="<%= field.name %>" type="file" accept="image/jpeg,image/png,image/webp,image/heic,application/pdf" <%= field.multiple ? 'multiple' : '' %>>
      <% if (Object.keys(errors).length) { %><p class="help">Les fichiers doivent être sélectionnés à nouveau après une erreur.</p><% } %>
    <% } else if (field.type === 'signature') { %>
      <div class="signature" data-signature>
        <canvas width="600" height="180" aria-label="Zone de signature"></canvas>
        <input type="hidden" name="<%= field.name %>" value="<%= v ?? '' %>">
        <button type="button" class="btn small ghost" data-signature-clear>Effacer</button>
      </div>
    <% } %>
  <% } %>
  <% if (field.help) { %><p class="help"><%= field.help %></p><% } %>
  <% if (err) { %><p class="error-msg"><%= err %></p><% } %>
</div>
<% } %>
