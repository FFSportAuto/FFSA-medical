<% if (formError) { %><div class="alert error" role="alert"><%= formError %></div><% } %>
<form method="post" action="<%= action %>" enctype="multipart/form-data" class="dyn-form" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <% form.sections.forEach(function (section, i) { %>
    <% const showIf = section.showIf ? JSON.stringify(section.showIf) : ''; %>
    <% if (section.optional) { %>
      <details class="card section optional" <%= sectionHasValues(section, values) ? 'open' : '' %> <% if (showIf) { %>data-show-if="<%= showIf %>"<% } %>>
        <summary><span class="step"><%= i + 1 %></span><%= section.title %> <span class="muted small">(facultatif)</span></summary>
    <% } else { %>
      <fieldset class="card section" <% if (showIf) { %>data-show-if="<%= showIf %>"<% } %>>
        <legend><span class="step"><%= i + 1 %></span><%= section.title %></legend>
    <% } %>
      <% if (section.intro) { %><p class="muted section-intro"><%= section.intro %></p><% } %>
      <div class="grid">
        <% section.fields.forEach(function (field) { %>
          <%- include('field', { field, values, errors }) %>
        <% }) %>
      </div>
    <%- section.optional ? '</details>' : '</fieldset>' %>
  <% }) %>
  <div class="actions">
    <button type="submit" class="btn primary large"><%= submitLabel %></button>
  </div>
</form>
