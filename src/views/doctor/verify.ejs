<%- include('../partials/header') %>
<div class="auth card">
  <h1>Rapport médical</h1>
  <p>Dossier <strong class="mono"><%= reference %></strong></p>
  <p class="muted">Pour protéger les données de santé, nous devons vérifier votre identité. Un code à usage unique va être envoyé à <strong><%= maskedEmail %></strong><% if (maskedPhone) { %> et par SMS au <strong><%= maskedPhone %></strong><% } %>.</p>
  <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
  <% if (codeSent) { %>
    <div class="alert info">Code envoyé. Il est valable 10 minutes.<% if (demoMode) { %> Démonstration : <a href="/demo/emails" target="_blank">ouvrir la boîte mail</a>.<% } %></div>
    <form method="post" action="/medecin/<%= token %>/verifier">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label class="label" for="code">Code reçu par e-mail</label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="6" required autofocus class="code-input"></div>
      <button class="btn primary full" type="submit">Accéder au formulaire</button>
    </form>
  <% } %>
  <form method="post" action="/medecin/<%= token %>/code" class="<%= codeSent ? 'secondary-form' : '' %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <button class="btn <%= codeSent ? 'ghost' : 'primary' %> full" type="submit"><%= codeSent ? 'Renvoyer un code' : 'Recevoir le code' %></button>
  </form>
</div>
<%- include('../partials/footer') %>
