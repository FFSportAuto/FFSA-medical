<%- include('../partials/header') %>
<div class="page-head"><h1>Journal d'audit</h1></div>
<div class="card table-wrap">
  <table class="compact">
    <thead><tr><th>Date</th><th>Acteur</th><th>Action</th><th>Cible</th><th>IP</th></tr></thead>
    <tbody>
    <% entries.forEach(function (e) { %>
      <tr>
        <td><%= new Date(e.at).toLocaleString('fr-FR', { timeZone: 'Europe/Paris' }) %></td>
        <td><%= e.actor %></td>
        <td class="mono"><%= e.action %></td>
        <td class="mono small"><%= e.target_type ? e.target_type + ' ' + e.target_id : '' %></td>
        <td class="mono small"><%= e.ip %></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</div>
<nav class="pager">
  <% if (page > 1) { %><a href="?page=<%= page - 1 %>">← Plus récents</a><% } %>
  <span>Page <%= page %></span>
  <% if (entries.length === 100) { %><a href="?page=<%= page + 1 %>">Plus anciens →</a><% } %>
</nav>
<%- include('../partials/footer') %>
