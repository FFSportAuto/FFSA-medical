<%- include('../partials/header') %>
<% const fmt = (d) => d ? new Date(d).toLocaleString('fr-FR', { timeZone: 'Europe/Paris', dateStyle: 'short', timeStyle: 'short' }) : '—'; %>
<div class="page-head">
  <h1>Dossier <span class="mono"><%= accident.reference %></span></h1>
  <div class="head-actions">
    <% if (accident.status === 'complete') { %><span class="badge ok">Complet</span><% } else { %><span class="badge wait">En attente du rapport médical</span><% } %>
    <button type="button" class="btn ghost" data-print>Imprimer</button>
  </div>
</div>
<% if (flash) { %><div class="alert success"><%= flash %></div><% } %>

<% if (overdue) { %><div class="alert error">Rapport médical en retard : demandé il y a plus de 48 heures. Relancez le médecin ci-dessous ou transmettez le lien à un autre médecin.</div><% } %>

<section class="card case no-print" id="suivi">
  <div class="case-grid">
    <form method="post" action="/back-office/dossiers/<%= accident.id %>/suivi" class="case-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <span class="eyebrow">Suivi du dossier</span>
      <div class="case-fields">
        <div class="field"><label class="label" for="processing_status">Statut de traitement</label>
          <select id="processing_status" name="processing_status">
            <% Object.entries(processing).forEach(function ([k, l]) { %><option value="<%= k %>" <%= accident.processing_status === k ? 'selected' : '' %>><%= l %></option><% }) %>
          </select></div>
        <div class="field"><label class="label" for="assigned_to">Médecin fédéral référent</label>
          <select id="assigned_to" name="assigned_to">
            <option value="">— Non attribué —</option>
            <% staff.forEach(function (u) { %><option value="<%= u.id %>" <%= accident.assigned_to === u.id ? 'selected' : '' %>><%= u.full_name %></option><% }) %>
          </select></div>
      </div>
      <button class="btn small" type="submit">Enregistrer</button>
    </form>
    <div class="notes" id="notes">
      <span class="eyebrow">Notes internes</span>
      <% if (!notes.length) { %><p class="muted small">Aucune note. Les notes ne sont visibles que par le service médical.</p><% } %>
      <ol class="note-list">
        <% notes.forEach(function (n) { %>
          <li><span class="muted small"><%= n.author || 'Utilisateur supprimé' %> · <%= fmt(n.created_at) %></span><p><%= n.body %></p></li>
        <% }) %>
      </ol>
      <form method="post" action="/back-office/dossiers/<%= accident.id %>/notes" class="note-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="label" for="note">Ajouter une note</label>
        <textarea id="note" name="note" rows="2" maxlength="5000" required></textarea>
        <button class="btn small" type="submit">Ajouter</button>
      </form>
    </div>
  </div>
</section>

<div class="card downloads no-print">
  <span class="eyebrow">Télécharger en PDF</span>
  <div class="row-actions">
    <a class="btn primary" href="/back-office/dossiers/<%= accident.id %>/pdf/complet">Dossier complet</a>
    <a class="btn" href="/back-office/dossiers/<%= accident.id %>/pdf/accident">Rapport d'accident</a>
    <a class="btn" href="/back-office/dossiers/<%= accident.id %>/pdf/medical">Rapport(s) médical(aux)</a>
  </div>
</div>

<div class="meta card">
  <div><span class="muted">Épreuve</span><strong><%= accident.event_name %></strong><% if (accident.discipline) { %><span class="disc small <%= disciplineClass(accident.discipline) %>"><%= accident.discipline %></span><% } %></div>
  <div><span class="muted">Déclaré par</span><strong><%= organizer.full_name %></strong> <span class="small muted"><%= organizer.email %></span></div>
  <div><span class="muted">Déclaré le</span><strong><%= fmt(accident.created_at) %></strong></div>
  <div><span class="muted">Rapport médical reçu le</span><strong><%= fmt(accident.completed_at) %></strong></div>
</div>

<div class="two-cols">
  <section class="card">
    <h2>Rapport d'accident</h2>
    <%- include('../partials/display', { sections: accidentSections }) %>
  </section>
  <section class="card">
    <h2>Rapport(s) médical(aux)</h2>
    <% medicalReports.forEach(function (m, i) { %>
      <div class="medical-report">
        <h3>Patient <%= i + 1 %> – <%= [m.data.patient_last_name, m.data.patient_first_name].filter(Boolean).join(' ') %></h3>
        <%- include('../partials/display', { sections: m.sections }) %>
      </div>
    <% }) %>
    <% if (accident.status !== 'complete') { %>
      <p class="muted"><%= medicalReports.length ? 'Le médecin n\u2019a pas encore clôturé le dossier.' : 'Le médecin n\u2019a pas encore transmis de rapport.' %></p>
      <h3>Invitations envoyées</h3>
      <ul class="plain">
        <% requests.forEach(function (r) { %>
          <li><%= r.doctorEmail %><%= r.doctorPhone ? ' · ' + r.doctorPhone : '' %><%= r.transferred_from ? ' (transmis par un confrère)' : '' %> — envoyée <%= fmt(r.sent_at) %><%= r.reminder_sent_at ? ' (relance)' : '' %>
            <% if (r.revoked_at) { %><span class="badge">remplacée</span><% } else if (new Date(r.expires_at) < new Date()) { %><span class="badge">expirée</span><% } else { %><span class="badge wait">valable jusqu'au <%= new Date(r.expires_at).toLocaleDateString('fr-FR') %></span><% } %>
          </li>
        <% }) %>
      </ul>
      <form method="post" action="/back-office/dossiers/<%= accident.id %>/relance" class="resend no-print">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="label" for="doctor_email">Renvoyer un lien au médecin</label>
        <div class="row">
          <input id="doctor_email" name="doctor_email" type="email" value="<%= requests[0] ? requests[0].doctorEmail : '' %>" required aria-label="E-mail du médecin">
          <input id="doctor_phone" name="doctor_phone" type="tel" value="<%= requests[0] && requests[0].doctorPhone ? requests[0].doctorPhone : '' %>" placeholder="Portable (SMS)" aria-label="Portable du médecin">
          <button class="btn primary" type="submit">Envoyer</button>
        </div>
        <p class="help">Les liens précédents seront désactivés.</p>
      </form>
    <% } %>
  </section>
</div>

<% if (attachments.length) { %>
<section class="card">
  <h2>Pièces jointes</h2>
  <table>
    <thead><tr><th>Fichier</th><th>Origine</th><th>Taille</th><th></th></tr></thead>
    <tbody>
    <% attachments.forEach(function (a) { %>
      <tr>
        <td><%= a.filename %></td>
        <td><%= a.source === 'medical' ? 'Rapport médical' : 'Rapport d’accident' %></td>
        <td><%= (a.size_bytes / 1024).toFixed(0) %> Ko</td>
        <td><a href="/back-office/dossiers/<%= accident.id %>/pieces/<%= a.id %>">Télécharger</a></td>
      </tr>
    <% }) %>
    </tbody>
  </table>
</section>
<% } %>
<p class="no-print"><a href="/back-office">← Retour aux dossiers</a></p>
<%- include('../partials/footer') %>
